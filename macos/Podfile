require 'pathname'
require 'json'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

prepare_react_native_project!

target 'ReactNativeStarter-macOS' do
  platform :macos, '14.0'
  excluded_macos_modules = ['react-native-safe-area-context', 'react-native-screens']
  native_modules = list_native_modules!($default_command)
  native_modules[:ios_packages].reject! { |package| excluded_macos_modules.include?(package[:name]) }
  link_native_modules!(native_modules)

  # macOS autolinking falls back to iOS and codegen uses the iOS target.
  autolinking_path = File.join(__dir__, 'build/generated/autolinking/autolinking.json')
  autolinking = JSON.parse(File.read(autolinking_path))
  excluded_macos_modules.each do |name|
    autolinking.fetch('dependencies').fetch(name).fetch('platforms')['ios'] = nil
  end
  File.write(autolinking_path, JSON.pretty_generate(autolinking))

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)
  end
end
